{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private S3 site with CloudFront, HTTPS, directory routing and a repository-scoped deployment role.",
  "Parameters": {
    "SiteName": {
      "Type": "String",
      "AllowedPattern": "[a-z][a-z0-9-]{0,23}"
    },
    "DomainName": {
      "Type": "String"
    },
    "RedirectDomains": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "CertificateArn": {
      "Type": "String"
    },
    "GitHubRepository": {
      "Type": "String"
    },
    "GitHubOwnerId": {
      "Type": "String"
    },
    "GitHubRepositoryId": {
      "Type": "String"
    },
    "GitHubBranch": {
      "Type": "String",
      "Default": "main"
    },
    "GitHubOwner": {
      "Type": "String"
    },
    "GitHubRepoName": {
      "Type": "String"
    }
  },
  "Conditions": {
    "HasRedirects": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Fn::Join": [
                ",",
                {
                  "Ref": "RedirectDomains"
                }
              ]
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "static-site-${SiteName}-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "ManagedBy",
            "Value": "static-site-deploy"
          },
          {
            "Key": "Site",
            "Value": {
              "Ref": "SiteName"
            }
          }
        ]
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-origin"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "Router": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-router"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Canonical domain and directory index routing",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "__ROUTER_CODE__"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {
            "Fn::Sub": "Static site: ${DomainName}"
          },
          "DefaultRootObject": "index.html",
          "Aliases": {
            "Fn::If": [
              "HasRedirects",
              {
                "Fn::Split": [
                  ",",
                  {
                    "Fn::Join": [
                      ",",
                      [
                        {
                          "Ref": "DomainName"
                        },
                        {
                          "Fn::Join": [
                            ",",
                            {
                              "Ref": "RedirectDomains"
                            }
                          ]
                        }
                      ]
                    ]
                  }
                ]
              },
              [
                {
                  "Ref": "DomainName"
                }
              ]
            ]
          },
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "Bucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "Router",
                    "FunctionMetadata.FunctionARN"
                  ]
                }
              }
            ]
          },
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "CertificateArn"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          }
        },
        "Tags": [
          {
            "Key": "ManagedBy",
            "Value": "static-site-deploy"
          },
          {
            "Key": "Site",
            "Value": {
              "Ref": "SiteName"
            }
          }
        ]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Bucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${Bucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "static-site-${SiteName}-deploy"
        },
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": [
                    {
                      "Fn::Sub": "repo:${GitHubRepository}:ref:refs/heads/${GitHubBranch}"
                    },
                    {
                      "Fn::Sub": "repo:${GitHubOwner}@${GitHubOwnerId}/${GitHubRepoName}@${GitHubRepositoryId}:ref:refs/heads/${GitHubBranch}"
                    }
                  ]
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeployThisSite",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Bucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeStacks",
                  "Resource": {
                    "Ref": "AWS::StackId"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "ManagedBy",
            "Value": "static-site-deploy"
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "Bucket"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "DistributionDomain": {
      "Value": {
        "Fn::GetAtt": [
          "Distribution",
          "DomainName"
        ]
      }
    },
    "DeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeploymentRole",
          "Arn"
        ]
      }
    },
    "SiteUrl": {
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      }
    }
  }
}
